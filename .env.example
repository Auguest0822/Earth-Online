NEWS_API_KEY=your_newsapi_key_here
NEWS_SERVER_PORT=8787

# Optional. Keep empty in local dev because Vite proxies /api to the backend.
# VITE_NEWS_BACKEND_URL=http://127.0.0.1:8787/api

# News data source: mock | api | auto
# mock: always use local demo data; api: prefer backend and show fallback warning;
# auto: try backend first, then silently fall back to local demo data.
VITE_NEWS_DATA_SOURCE=mock

# Business data source: mock | api | auto
VITE_APP_DATA_SOURCE=mock
VITE_API_BASE_URL=/api

# Backend only. Never expose this key through a VITE_ variable or commit a real value.
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_CONNECT_TIMEOUT_SECONDS=10
DEEPSEEK_READ_TIMEOUT_SECONDS=60

# Spring Boot secrets (configure these in the IDE run configuration or OS environment).
DB_URL=jdbc:mysql://localhost:3306/earth_online?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai
DB_USERNAME=root
DB_PASSWORD=your_mysql_password
JWT_SECRET=replace_with_a_random_secret_at_least_32_characters_long
JWT_EXPIRATION_MS=86400000
