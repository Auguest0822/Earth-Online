# Business data source: mock | api | auto
VITE_APP_DATA_SOURCE=mock
VITE_API_BASE_URL=/api

# Backend only. Never expose this key through a VITE_ variable or commit a real value.
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_CONNECT_TIMEOUT_SECONDS=10
DEEPSEEK_READ_TIMEOUT_SECONDS=60

# Spring Boot secrets (configure these in the IDE run configuration or OS environment).
DB_URL=jdbc:mysql://localhost:3306/earth_online?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai
DB_USERNAME=root
DB_PASSWORD=your_mysql_password
JWT_SECRET=replace_with_a_random_secret_at_least_32_characters_long
JWT_EXPIRATION_MS=86400000
