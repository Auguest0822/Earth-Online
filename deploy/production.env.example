# Copy this file to /opt/earth-online/.env on the server. Never commit real values.
DB_PASSWORD=replace_with_database_password
MYSQL_ROOT_PASSWORD=replace_with_different_root_password
JWT_SECRET=replace_with_a_random_secret_at_least_32_characters
MINIO_ACCESS_KEY=earthonline
MINIO_SECRET_KEY=replace_with_a_long_random_minio_secret
DEEPSEEK_API_KEY=replace_with_deepseek_api_key
PUBLIC_ORIGIN=http://replace_with_elastic_public_ip
# 浏览器页面所在的地址；多个地址以英文逗号分隔。HTTP 和 HTTPS 是不同 Origin。
CHAT_WEBSOCKET_ALLOWED_ORIGIN_PATTERNS=http://replace_with_elastic_public_ip,http://localhost:5173
JWT_EXPIRATION_MS=86400000
