# Earth Online 生产环境变量模板
# 用法：复制到服务器 /opt/earth-online/.env，把 replace_with_... 换成真实值。
# 这个文件在服务器上，不进 Git；不要把真实密钥写进仓库。

# ---------- 数据库 ----------
# 注意：MySQL 容器第一次启动时会用这两个密码初始化数据卷。
# 之后修改这里不会改数据库里的密码，后端会连不上（详见部署文档 FAQ）。
DB_PASSWORD=replace_with_database_password
MYSQL_ROOT_PASSWORD=replace_with_different_root_password

# ---------- 登录令牌 ----------
# 至少 32 位随机字符串。修改后所有已登录用户的 Token 立即失效，需要重新登录。
JWT_SECRET=replace_with_a_random_secret_at_least_32_characters
JWT_EXPIRATION_MS=86400000

# ---------- MinIO 图片存储 ----------
# 同样只在第一次初始化数据卷时生效，之后修改需要同步改 MinIO 容器里的用户。
MINIO_ACCESS_KEY=earthonline
MINIO_SECRET_KEY=replace_with_a_long_random_minio_secret

# ---------- AI（年度总结 / RAG 问答）----------
DEEPSEEK_API_KEY=replace_with_deepseek_api_key

# ---------- 公网来源（IP 变化时必须改）----------
# 浏览器地址栏里的来源，就是“协议 + 公网 IP/域名”，结尾不要带 /。
# 图片预签名地址和 WebSocket 白名单都以它为基础。
PUBLIC_ORIGIN=http://replace_with_elastic_public_ip

# 可选。浏览器的 WebSocket 必须来自白名单地址，否则握手返回 403，实时聊天不可用。
# 不设置时 docker-compose 默认使用 PUBLIC_ORIGIN，因此单域名部署可以不写这一行。
# 需要额外来源（例如同时用域名和 IP、或者本地调试）时，用英文逗号分隔：
#   注意：HTTP 与 HTTPS、带端口与不带端口，都算不同的 Origin。
CHAT_WEBSOCKET_ALLOWED_ORIGIN_PATTERNS=http://replace_with_elastic_public_ip,http://localhost:5173
